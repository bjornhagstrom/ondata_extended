{
  "name": "@ondata-extended/host-ckan",
  "version": "0.1.0",
  "private": true,
  "description": "Deployment of the CKAN profile as ondata/ckan-mcp-server: the ckan-mcp-server binary (stdio, Node HTTP) and the Cloudflare Worker.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ckan-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/node.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js='#!/usr/bin/env node' --external:@modelcontextprotocol/sdk --external:express --external:zod --external:undici",
    "build:worker": "esbuild src/worker.ts --bundle --platform=browser --format=esm --target=es2022 --minify --outfile=dist/worker.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@ondata-extended/core": "0.1.0",
    "@ondata-extended/profile-ckan": "0.1.0",
    "@ondata-extended/profile-contract": "0.1.0",
    "express": "^4.21.2",
    "undici": "^7.16.0",
    "zod": "^3.25.76"
  }
}
