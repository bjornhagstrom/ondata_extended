{
  "name": "@ondata-extended/host-example",
  "version": "0.1.0",
  "private": true,
  "description": "Deployment of the example profile (docs/writing-a-profile.md): a stdio binary and a Cloudflare Worker. Not deployed.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "akn-example-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/node.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js='#!/usr/bin/env node' --external:@modelcontextprotocol/sdk --external:zod --external:undici",
    "build:worker": "esbuild src/worker.ts --bundle --platform=browser --format=esm --target=es2022 --minify --outfile=dist/worker.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@ondata-extended/core": "0.1.0",
    "@ondata-extended/profile-contract": "0.1.0",
    "@ondata-extended/profile-example": "0.1.0",
    "undici": "^7.16.0",
    "zod": "^3.25.76"
  }
}
